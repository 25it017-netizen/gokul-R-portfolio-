# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional: Configure Resend API key to enable direct server-side email delivery from the contact form.
# When omitted, the contact form gracefully hands off to the visitor's email client without fake confirmations.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Portfolio Inquiry <onboarding@resend.dev>"
CONTACT_RECIPIENT_EMAIL="rgksrt10@gmail.com"
